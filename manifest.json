{
    "name": "Ozon stop charity",
    "description": "Hides charity items on Ozon.ru",
    "version": "1.0",
    "manifest_version": 3,
    "icons": {
        "16": "icons/icon-16x16.png",
        "32": "icons/icon-32x32.png",
        "48": "icons/icon-48x48.png",
        "128": "icons/icon-128x128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.ozon.ru/*",
                "https://ozon.ru/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}